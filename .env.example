# WellPaiD Trader - Environment Configuration
# Copy this file to .env and customize as needed.
# NEVER commit .env to version control.
# NEVER place real API keys, passwords, or secrets here.

# Application Settings
APP_NAME=WellPaiD Trader
ENVIRONMENT=development
LOG_LEVEL=INFO

# Trading Safety Controls
# These MUST remain false until explicitly authorized
TRADING_ENABLED=false
PAPER_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false

# API Keys (leave blank if not using)
# NEVER commit real API keys to version control
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Database
DATABASE_URL=sqlite:///wellpaid.db

# Risk Engine Defaults
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=500
MAX_DRAWDOWN=0.1
MAX_TRADES_PER_DAY=10
MAX_NOTIONAL_PER_TRADE=100000
MAX_TOTAL_NOTIONAL_EXPOSURE=500000

# HTTP API (agent/api/server.py) - token is MANDATORY to start the server.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
WELLPAID_API_TOKEN=
